# Copy to .env and replace every placeholder with a strong secret.
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/techsathi
EMAIL_USER=your-business-email@gmail.com
EMAIL_PASS=your-gmail-app-password
JWT_SECRET=replace-with-at-least-32-random-characters
OTP_PEPPER=replace-with-a-different-at-least-32-character-random-secret
# Comma-separated exact browser origins. Add your real production domain.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
